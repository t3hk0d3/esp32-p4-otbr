# Chip and flash (Phase 0: board is ESP32-P4 rev v1.3, 32 MB flash, 32 MB PSRAM)
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# PSRAM, code and rodata executed from PSRAM so flash erase/write never stalls the cores (spec 5.11)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# Partition table (spec 5.1) and rollback
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_MD5=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Core dump to flash
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# Console on the UART0 bridge (CH343)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# No secondary console: the logging component owns USB-Serial-JTAG (it installs the driver and writes log lines there
# at the JTAG channel's level); the console stays on UART0.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# Logging: a release build compiles in up to Info (the ESP-IDF default), so Debug and Verbose calls cost no flash or
# time; a test build (make build-test) adds them through sdkconfig.defaults.test.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=5120
# VFS slots: console, three SPIFFS mounts, OpenThread eventfd, and room for more
CONFIG_VFS_MAX_COUNT=12
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3584

# Ethernet: IP101 on the internal EMAC, driven through the generic 802.3 PHY driver
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y

# Network path on core 0 (spec 5.11)
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_MDNS_TASK_AFFINITY_CPU0=y
# Management on core 1: the rest of app_main runs there (net_init is a pinned core-0 task)
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y

# lwIP: IPv6 autoconfig, forwarding and the hooks OpenThread's border router needs.
# Do not change options that alter struct netif (PPP, NUM_NETIF_CLIENT_DATA, VLAN): the prebuilt
# libopenthread_br.a reads struct netif at fixed offsets.
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_FORWARD=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=12
CONFIG_LWIP_MULTICAST_PING=y
CONFIG_LWIP_NETIF_STATUS_CALLBACK=y
CONFIG_LWIP_FORCE_ROUTER_FORWARDING=y
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
# The hook functions are provided by esp_openthread (linked through br_core).
CONFIG_LWIP_HOOK_IP6_INPUT_CUSTOM=y
CONFIG_LWIP_HOOK_IP6_SELECT_SRC_ADDR_CUSTOM=y
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_SERVER_SUPPORT=y
CONFIG_LWIP_NUM_NETIF_CLIENT_DATA=0

# Sockets: web server 10 (max_open_sockets 7 + listener + 2 control sockets) + mesh routing up to 7 (BGP: a listener,
# a current and a pending connection per peer, and 2 closing after a NOTIFICATION; RIPng: one, never both methods at
# once) + 1 HTTP client (OTA, a radio firmware URL or the update check, which share it) + 6 RCP proxy (two channels in rcp-proxy at once, the C6 and the
# one open USB device, each a listener, its client and one connection being refused) + 1 syslog (UDP) = 25. mDNS,
# OpenThread, DNS and SNTP use lwIP raw PCBs, not sockets. routing/task.c fails the build below that. An existing
# p4/sdkconfig keeps its old value: delete it after pulling (docs/development.md).
CONFIG_LWIP_MAX_SOCKETS=25
# Active TCP PCBs: the 16 of before were used up by the same sockets; the RCP proxy adds per channel its client and a
# refused connection, plus headroom for PCBs still closing (TIME_WAIT) = 22. A refused proxy client is closed with a FIN
# (an RST only when its bytes were still unread: lwIP's SO_LINGER {1, 0} resets only a connection with unsent data), so
# its PCB lingers in FIN_WAIT or TIME_WAIT; its socket is free at once, and lwIP takes such PCBs back, oldest first,
# when a new connection needs one (tcp_alloc).
CONFIG_LWIP_MAX_ACTIVE_TCP=22
# UDP PCBs (every UDP socket holds one too), the most open at once: lwIP's DNS client 4 (a random source port per
# request, DNS_TABLE_SIZE) + DHCP client 1 (shared by the netifs) + mDNS 1 (one PCB for both interfaces) + TREL 1 +
# OpenThread's platform UDP 5 (DNS-SD server, Border Agent, its ephemeral-key agent, backbone TMF, DNS client) + the
# DHCPv6-PD client (OpenThread infra_if) 1 + RIPng 1 + RCP proxy over UDP 2 (one per channel) + syslog 1 + SNTP 1
# (time sync) = 18. On top come PCBs made per flow: a socket per DNS query OpenThread forwards upstream, and a PCB per
# NAT64 UDP session; the other 14 are their room. lwIP allocates PCBs from the heap (MEMP_MEM_MALLOC),
# so the limit costs nothing until used. logging_capture.c fails the build below 32; an existing p4/sdkconfig keeps
# its old value (16): delete it after pulling (docs/development.md).
CONFIG_LWIP_MAX_UDP_PCBS=32

# USB host: a configuration descriptor over 256 bytes fails enumeration at the default control transfer size (USB/IP
# exports composite devices).
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1024

# lwIP never forwards IPv4: no routing between interfaces (spec 5.13); NAT64 egress is generated locally by OpenThread.
CONFIG_LWIP_IP_FORWARD=n

# Time sync (timesync): DHCP asks for option 42 (NTP servers); timesync takes them through its wrap of
# dhcp_set_ntp_servers, with the interface they came on, and sets the SNTP servers itself (SNTP's own DHCP mode stays
# off). Up to two servers from the lease, two in the SNTP client. SNTP uses a raw PCB: the socket count is unchanged.
CONFIG_LWIP_DHCP_GET_NTP_SRV=y
CONFIG_LWIP_DHCP_MAX_NTP_SERVERS=2
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# mDNS: the SRP advertising proxy and Border Agent register many services (Phase 0 value)
CONFIG_MDNS_MULTIPLE_INSTANCE=y
CONFIG_MDNS_MAX_SERVICES=200
# netcfg registers every Ethernet netif with mDNS itself (netcfg ifaces.c): the predefined interfaces would take all of the
# slots (STA, AP and ETH are one each) and watch only the netif with the key ETH_DEF. At most two interfaces exist.
CONFIG_MDNS_PREDEF_NETIF_STA=n
CONFIG_MDNS_PREDEF_NETIF_AP=n
CONFIG_MDNS_PREDEF_NETIF_ETH=n
CONFIG_MDNS_MAX_INTERFACES=2

# mbedTLS features OpenThread needs (commissioning)
CONFIG_MBEDTLS_CMAC_C=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECJPAKE=y
CONFIG_MBEDTLS_ECJPAKE_C=y

# OpenThread border router over SPI spinel, raw link through the custom header
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_BORDER_ROUTER=y
# The vendored REST server (esp_ot_br_server) joins and commissions.
CONFIG_OPENTHREAD_COMMISSIONER=y
CONFIG_OPENTHREAD_COMM_MAX_JOINER_ENTRIES=2
CONFIG_OPENTHREAD_JOINER=y
CONFIG_OPENTHREAD_RADIO_SPINEL_SPI=y
CONFIG_OPENTHREAD_HEADER_CUSTOM=y
CONFIG_OPENTHREAD_CUSTOM_HEADER_PATH="main"
CONFIG_OPENTHREAD_CUSTOM_HEADER_FILE_NAME="esp_ot_custom_config.h"
# TREL (Thread Radio Encapsulation Link) on the backbone interface, next to the 15.4 radio: OpenThread mesh links over
# Ethernet to other border routers of the same Thread network. On by default, switched live by PUT /device/network.
# The receive ring holds pbufs until the OpenThread task reads them; 20 is plenty for a home network.
CONFIG_OPENTHREAD_RADIO_TREL=y
CONFIG_OPENTHREAD_TREL_BUFFER_SIZE=20
# The RCP firmware is pushed on request (R14); esp_ot_cli_extension's rcp command would need esp_rcp_update.
CONFIG_OPENTHREAD_RCP_COMMAND=n

# The OTA command of esp_ot_cli_extension would bypass the bundle format (spec 5.8); keep it off.
CONFIG_OPENTHREAD_CLI_OTA=n

# Diagnostics (spec 5.12): task list and per-task run time (all builds), core id in the task status
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# Thread console (spec 2026-11-04-thread-console): GET /device/console/ws. The pre-handshake callback runs the
# per-interface policy before the upgrade; the post-handshake callback attaches the socket to the console.
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y

# https download URLs (OTA, radio firmware, the update check): verify the server against the bundled root certificates
# (the common set: Sectigo, USERTrust and ISRG cover github.com and its asset host). No pinning.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y

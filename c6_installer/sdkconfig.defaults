CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# The installer rewrites the bootloader (0x0) and the partition table (0x8000).
CONFIG_SPI_FLASH_DANGEROUS_WRITE_ALLOWED=y

# The install runs in app_main for seconds without yielding to the idle task.
CONFIG_ESP_TASK_WDT_INIT=n

# Its own partition table and bootloader are never flashed: the stock ESP-Hosted ones boot it.
CONFIG_PARTITION_TABLE_SINGLE_APP=y
